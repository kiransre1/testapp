    "scenarios": [
      {
        "key": "SC-001",
        "version": 1,
        "title": "Signed-in member sees their task list",
        "rationale": "Core value: after sign-in the member must land on a populated task list.",
        "priority": "P0",
        "riskArea": "core_flow",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-VIEW",
        "preconditions": ["Signed in with the synthetic account"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 6,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          { "action": "assertUrl", "contains": "/tasks" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Your tasks" }
          },
          {
            "action": "assertCount",
            "locator": { "by": "testId", "value": "task-item" },
            "count": 1,
            "comparison": "gte"
          },
          { "action": "screenshot", "label": "task list" }
        ],
        "expectedOutcomes": ["Task list heading is visible", "At least one task is listed"]
      },
      {
        "key": "SC-002",
        "version": 1,
        "title": "Create a disposable task",
        "rationale": "Happy path for the primary write journey.",
        "priority": "P0",
        "riskArea": "core_flow",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-CREATE",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "disposable_write",
        "prohibitedActionClass": "none",
        "maxActions": 8,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          {
            "action": "fill",
            "locator": { "by": "label", "value": "Title" },
            "value": "{{run}} Write report"
          },
          { "action": "click", "locator": { "by": "role", "role": "button", "name": "Add task" } },
          {
            "action": "assertText",
            "locator": { "by": "role", "role": "status" },
            "text": "Task added"
          },
          {
            "action": "assertVisible",
            "locator": { "by": "text", "value": "{{run}} Write report" }
          }
        ],
        "expectedOutcomes": ["A confirmation is shown", "The new task appears in the list"]
      },
      {
        "key": "SC-003",
        "version": 1,
        "title": "Created task persists after reload",
        "rationale": "Persistence: a created record must survive a page reload.",
        "priority": "P1",
        "riskArea": "persistence",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-CREATE",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "disposable_write",
        "prohibitedActionClass": "none",
        "maxActions": 8,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          {
            "action": "fill",
            "locator": { "by": "label", "value": "Title" },
            "value": "{{run}} Persist check"
          },
          { "action": "click", "locator": { "by": "role", "role": "button", "name": "Add task" } },
          {
            "action": "assertVisible",
            "locator": { "by": "text", "value": "{{run}} Persist check" }
          },
          { "action": "reload" },
          {
            "action": "assertVisible",
            "locator": { "by": "text", "value": "{{run}} Persist check" }
          }
        ],
        "expectedOutcomes": ["The task is still listed after reload"]
      },
      {
        "key": "SC-004",
        "version": 1,
        "title": "Missing title is rejected with an error",
        "rationale": "Validation: the brief says a title is required.",
        "priority": "P1",
        "riskArea": "validation",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-CREATE",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "disposable_write",
        "prohibitedActionClass": "none",
        "maxActions": 6,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          { "action": "fill", "locator": { "by": "label", "value": "Title" }, "value": "" },
          { "action": "click", "locator": { "by": "role", "role": "button", "name": "Add task" } },
          {
            "action": "assertText",
            "locator": { "by": "role", "role": "alert" },
            "text": "Title is required"
          }
        ],
        "expectedOutcomes": ["An error explains that a title is required", "No task is created"]
      },
      {
        "key": "SC-005",
        "version": 1,
        "title": "Edited task title is saved and persists",
        "rationale": "Persistence of edits is a core journey in the brief.",
        "priority": "P0",
        "riskArea": "persistence",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-EDIT",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "disposable_write",
        "prohibitedActionClass": "none",
        "maxActions": 12,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          {
            "action": "fill",
            "locator": { "by": "label", "value": "Title" },
            "value": "{{run}} Original"
          },
          { "action": "click", "locator": { "by": "role", "role": "button", "name": "Add task" } },
          {
            "action": "click",
            "locator": { "by": "role", "role": "link", "name": "Edit {{run}} Original" }
          },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Edit task" }
          },
          {
            "action": "fill",
            "locator": { "by": "label", "value": "Title" },
            "value": "{{run}} Renamed"
          },
          {
            "action": "click",
            "locator": { "by": "role", "role": "button", "name": "Save changes" }
          },
          {
            "action": "assertVisible",
            "locator": { "by": "text", "value": "{{run}} Renamed" },
            "description": "renamed task is listed after saving"
          },
          { "action": "reload" },
          {
            "action": "assertVisible",
            "locator": { "by": "text", "value": "{{run}} Renamed" },
            "description": "renamed task is still listed after reload"
          }
        ],
        "expectedOutcomes": ["The list shows the new title after saving and after reload"]
      },
      {
        "key": "SC-006",
        "version": 1,
        "title": "Reports page shows task statistics",
        "rationale": "The brief says Reports shows the total number of tasks.",
        "priority": "P1",
        "riskArea": "error_handling",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-REPORTS",
        "preconditions": ["Signed in"],
        "startRoute": "/reports",
        "requiresAuth": true,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 5,
        "steps": [
          { "action": "navigate", "target": "/reports" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Reports" }
          },
          { "action": "assertVisible", "locator": { "by": "text", "value": "Total tasks:" } }
        ],
        "expectedOutcomes": ["Statistics including the total number of tasks are visible"]
      },
      {
        "key": "SC-007",
        "version": 1,
        "title": "Task list passes automated accessibility checks",
        "rationale": "Screen-reader users need named controls on the main page.",
        "priority": "P2",
        "riskArea": "accessibility",
        "personaKey": "P-AT-USER",
        "journeyKey": "J-VIEW",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 4,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Your tasks" }
          },
          { "action": "runAccessibilityCheck", "label": "task list" }
        ],
        "expectedOutcomes": ["No automated accessibility rule violations"]
      },
      {
        "key": "SC-008",
        "version": 1,
        "title": "Help page renders and passes automated accessibility checks",
        "rationale": "Help content must be reachable and accessible.",
        "priority": "P2",
        "riskArea": "accessibility",
        "personaKey": "P-MEMBER",
        "journeyKey": "J-HELP",
        "preconditions": ["Signed in"],
        "startRoute": "/help",
        "requiresAuth": true,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 4,
        "steps": [
          { "action": "navigate", "target": "/help" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Help" }
          },
          { "action": "runAccessibilityCheck", "label": "help page" }
        ],
        "expectedOutcomes": [
          "Help heading is visible",
          "No automated accessibility rule violations"
        ]
      },
      {
        "key": "SC-009",
        "version": 1,
        "title": "Primary navigation reaches Reports",
        "rationale": "Members on any device must be able to reach Reports from the main navigation.",
        "priority": "P2",
        "riskArea": "responsive",
        "personaKey": "P-MOBILE",
        "journeyKey": "J-REPORTS",
        "preconditions": ["Signed in"],
        "startRoute": "/tasks",
        "requiresAuth": true,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 5,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "link", "name": "Reports" },
            "description": "Reports link is visible in the primary navigation"
          },
          { "action": "click", "locator": { "by": "role", "role": "link", "name": "Reports" } },
          { "action": "assertUrl", "contains": "/reports" }
        ],
        "expectedOutcomes": ["The Reports link is visible and navigates to /reports"]
      },
      {
        "key": "SC-010",
        "version": 1,
        "title": "Signed-out visitor is redirected to sign-in",
        "rationale": "Protected pages must not be visible without a session.",
        "priority": "P1",
        "riskArea": "permissions",
        "personaKey": "P-VISITOR",
        "journeyKey": "J-ACCESS",
        "preconditions": ["No session"],
        "startRoute": "/tasks",
        "requiresAuth": false,
        "dataMode": "read_only",
        "prohibitedActionClass": "none",
        "maxActions": 4,
        "steps": [
          { "action": "navigate", "target": "/tasks" },
          { "action": "assertUrl", "contains": "/login" },
          {
            "action": "assertVisible",
            "locator": { "by": "role", "role": "heading", "name": "Sign in to TaskPad" }
          }
        ],
        "expectedOutcomes": ["The visitor sees the sign-in page instead of tasks"]
      }
    ],
    "assumptions": [
      "Each member only sees their own tasks (single role described in the brief).",
      "A task title is required; other fields are optional."
    ],
    "unsupportedAreas": [
      { "area": "Role-based permissions", "reason": "Only one role is described." },
      {
        "area": "Due-date business rules",
        "reason": "The brief does not define due-date validation."
