# TestApp environment configuration. Copy to .env and fill in real values.
# NEVER commit .env. Generate secrets locally, e.g.:
#   openssl rand -base64 48   (SESSION_SECRET)
#   openssl rand -base64 32   (APP_ENCRYPTION_KEY: must decode to exactly 32 bytes)

# --- Database (Compose builds DATABASE_URL from these) ---
POSTGRES_USER=testapp
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=testapp
# For local (non-Compose) development only:
DATABASE_URL=postgres://testapp:change-me-postgres-password@127.0.0.1:5432/testapp

# --- Web application ---
# Public URL users reach TestApp on (behind your HTTPS reverse proxy in production).
APP_BASE_URL=http://127.0.0.1:3000
# Loopback by default; only change if a reverse proxy on another host needs it.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Set true when served over HTTPS so cookies get the Secure attribute.
COOKIE_SECURE=false
# Random string, at least 32 characters. Used to derive the CSRF HMAC key.
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# 32 random bytes, base64. Encrypts stored target credentials (AES-256-GCM).
# Losing it makes stored target credentials unrecoverable.
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output=

# --- Single-user bootstrap (used once, when no user exists) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# --- Artifact storage (private; never inside the web public dir) ---
DATA_DIR=./.data

# --- LLM provider ---
# fake: deterministic, offline, no API key. Used for the demo and CI.
# anthropic: real provider. Requires ANTHROPIC_API_KEY and ANTHROPIC_MODEL.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Supply a model ID that YOUR Anthropic account supports. TestApp does not
# hardcode a model name.
ANTHROPIC_MODEL=
# Optional pricing (USD per million tokens) used ONLY to compute estimated cost.
# Cost figures are estimates; token and time caps are enforced independently.
ANTHROPIC_INPUT_PRICE_PER_MTOK=
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=

# --- Demo mode ---
# When true, the demo-target Docker hostname(s) below may be allowlisted.
DEMO_MODE=false
DEMO_TARGET_HOSTNAMES=demo-target
# Synthetic credentials for the bundled demo target ONLY (not real accounts).
DEMO_TARGET_USERNAME=demo.user@example.test
DEMO_TARGET_PASSWORD=demo-synthetic-password

# --- Global default run budgets (per-run values can be lowered in the UI) ---
DEFAULT_MAX_ELAPSED_MINUTES=20
DEFAULT_MAX_SCENARIOS=20
DEFAULT_MAX_ACTIONS_PER_SCENARIO=40
DEFAULT_MAX_TOTAL_ACTIONS=400
DEFAULT_MAX_INPUT_TOKENS=200000
DEFAULT_MAX_OUTPUT_TOKENS=40000
DEFAULT_MAX_ESTIMATED_COST_USD=2
DEFAULT_MAX_REPEATED_ACTIONS=5
DEFAULT_MAX_CONSECUTIVE_BLOCKED=3

# --- Worker ---
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
